PORT=8081
SCALA_ANALYSIS_URL=http://localhost:8080/analyze
SCALA_TIMEOUT=10s
ANALYSIS_WORKERS=4
ANALYSIS_CAPACITY=128
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_RETRY_BASE=1s
ANALYSIS_RETRY_MAX=10s
SHUTDOWN_TIMEOUT=30s
# Catálogo de eventos alternativo (por defecto se usa internal/validation/event_catalog.json embebido)
EVENT_CATALOG_PATH=
# Bandeja de archivos: vacío desactiva la ingestión por archivos
INBOX_DIR=../data/inbox
INBOX_POLL_INTERVAL=500ms
INBOX_WORKERS=4
