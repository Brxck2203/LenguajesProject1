# Copiar a .env para cambiar valores de docker compose (opcional).
GO_PORT=8081
SCALA_PORT=8080
# true omite las pruebas dentro de las imágenes (el CI ya las ejecuta antes).
SKIP_TESTS=false
# Registro y etiqueta de las imágenes (docker-compose.release.yml usa ghcr.io por defecto).
# IMAGE_REGISTRY=ghcr.io/brxck2203/lenguajesproject1
# GAMESTATS_TAG=latest
